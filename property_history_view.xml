<odoo>
    <record id="property_history_view_tree_v2" model="ir.ui.view">
        <field name="name">property.history.tree.v2</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <tree class="header_custom" create="0" edit="0" delete="0">
                <field name="user_id" />
                <field name="property_id" />
                <field name="old_state" />
                <field name="new_state"/>
            </tree>
        </field>
    </record>
    <record id="property_history_view_form" model="ir.ui.view">
        <field name="name">property history form</field>
        <field name="model">property.history</field> 
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="old_state"/>
                            <field name="new_state"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="reason"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Bedrooms">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="description"/>
                                    <field name="area"/>
                                </tree>
                            </field>

                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>
    


    <record id="property_history_action" model="ir.actions.act_window">
        <field name="name">Property history</field>
        <field name="res_model">property.history</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="property_history_menu_items"
        name="History"
        parent="properties_menu"
        action="property_history_action" />
    


    
</odoo>