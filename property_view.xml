<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class="header_custom" decoration-danger="(is_late)" multi_edit="1" create="1" edit="1" delete="0">
                <header>
                    <button name="property_xlsx_report" type="object" string="print Excel report"
                        class="btn-primary"/>
                </header>
                <field name="owner_id" />
                <field name="name" />
                <field name="state" />
                <field name="is_late"  invisible="1"/>
                <field name="description" />
                <field name="postcode" />
                <field name="date_availab" required="1" />
                <field name="expeceted_price" />
                <field name="selling_price" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="facades" />
                <field name="garage" />
                <field name="garden" />
                <field name="garden_area" optional="1" />
                <field name="garden_orientation" optional="1" />
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field> 
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box">

                        <button name="action_related_owner" type="object" icon="fa-user" string="Owner"
                        invisible="not owner_id"/>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="state != 'sold' or active== False"/>
                    <widget name="web_ribbon" title="Pending" bg_color="text-bg-success" invisible="state != 'pending' or active== False"/>
                    <widget name="web_ribbon" title="Draft" bg_color="text-bg-success" invisible="state != 'draft' or active== False"/>
                    <widget name="web_ribbon" title="closed" bg_color="text-bg-danger" invisible="state != 'closed' or active== False"/>
                    <header>
                        <button name="action_send_property_email" string="Send by Email" type="object" class="oe_highlight" icon="fa-envelope-o"/>
                        <button string="confirm" special="save" class="btn-primary"/>
                        <button name="action" type="object" class="btn-primary" string="Action"/>
                        <button name="get_properties" type="object" class="btn-primary" string="test call get properties"/>  
            
                        <field name="state" widget="statusbar" />
                    </header>
                    <div class="oe_title">
                        <label for="ref" />
                        <h1>
                            <field name="ref" />
                        </h1>
                        <label for="name" />
                        <h3>
                            <field name="name" readonly="state == 'closed'" />
                        </h3>


                    </div>
                    <group>
                        <group string="General Info. ">


                            <field name="postcode" readonly="state == 'closed'"/>
                            <field name="product_id" readonly="state == 'closed'"/>
                            <field name="partner_id" readonly="state == 'closed'"/>
                            <field name="create_time" readonly="1"/>
                            <field name="next_time" readonly="1"/>
                            <field name="date_availab" readonly="state == 'closed'" />
                            <field name="exceptd_selling_date" readonly="state == 'closed'" />
                            <field name="is_late" readonly="state == 'closed'"/>                    
                            <field name="expeceted_price" readonly="state == 'closed'"/>
                            <field name="selling_price" readonly="state == 'closed'"/>
                            <field name="diff" readonly="state == 'closed'"/>


                            <field name="bedrooms" readonly="state == 'closed'"/>
                            <field name="living_area" readonly="state == 'closed'"/>
                        </group>
                        <group string="Addtional Info. ">
                            <field name="owner_id" readonly="state == 'closed'"/>
                            <field name="owner_address" readonly="state == 'closed'"/>
                            <field name="owner_phone" readonly="state == 'closed'"/>
                            <field name="facades" readonly="state == 'closed'"/>
                            <field name="garage" readonly="state == 'closed'"/>
                            <field name="garden" readonly="state == 'closed'"/>
                            <field name="garden_area" readonly="state == 'closed'"/>
                            <field name="garden_orientation" readonly="state == 'closed'"/>
                            <field name="active" readonly="state == 'closed'"/>
                            
                        </group>
                    </group>
                    <group>
                        <field name="description" readonly="state == 'closed'" />
                        <field name="tag_ids"/>
                    </group>
                    <notebook>
                        <page string="Bedrooms">
                            <field name="line_ids" readonly="state == 'closed'">
                                <tree editable="bottom">
                                    <field name="description"/>
                                    <field name="area"/>
                                </tree>
                            </field>

                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <filter name="is_Garden" string="With Garden" domain="[('garden', '=', True)]" />
                <filter name="is_not_Garage" string="Without Garage"
                    domain="[('garage', '=', False)]" />
                <filter name="is_Garage" string="With Garage" domain="[('garage', '=', True)]" />

                <filter name="Groub_Garden" string="Garden" context="{'group_by':'garden'}" />
            </search>
        </field>
    </record>


    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">property</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="property_menu_items"
        name="properties"
        parent="properties_menu"
        action="property_action" />


    <record id="ListView_menu_action" model="ir.actions.client">
        <field name="name">Properties List View</field>
        <field name="tag">app_one.action_list_view</field>
    </record>

    <menuitem id="property_listView_menu_items"
        name="properties OWL"
        parent="properties_menu"
        action="ListView_menu_action" />
        

    <!-- Client Action اللي بينادي على الـ OWL Dashboard Component -->
    <record id="action_real_estate_dashboard_client" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">app_one.action_real_estate_dashboard</field>
    </record>

    <!-- عنصر المنيو اللي هيظهر فوق في أودو عشان تفتح منه الـ Dashboard -->
    <menuitem id="menu_real_estate_dashboard"
              name="Dashboard"
              parent="properties_menu"
              action="action_real_estate_dashboard_client"
              sequence="1"/>


    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">Closed</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action=records.action_closed()
        </field>
    </record>

    <record id="property_check_expected_date_cron" model="ir.cron">
        <field name="name">Property: check selling date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">model._check_exceptd_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>