<odoo>
    <record id="property_report" model="ir.actions.report">
        <field name="name">Property report</field>
        <field name="model">property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_property"/>
        <field name="binding_type">report</field>
        <field name="report_name">app_one.property_report_template</field>
    </record>

    <template id="property_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="rec">
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2 class="font-weight-bold" style="color: #2C3E50; border-bottom: 2px solid #2C3E50; padding-bottom: 8px;">
                                    Property Report: <span t-field="rec.name"/>
                                </h2>
                            </div>
                        </div>

                        <!-- General Information Section -->
                        <table class="table table-bordered table-sm mt-3" style="font-size: 14px;">
                            <thead>
                                <tr class="bg-light">
                                    <th colspan="4" class="text-center font-weight-bold" style="background-color: #f2f2f2; color: #2C3E50;">
                                        General Information
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="font-weight-bold bg-light" style="width: 20%;">Name</td>
                                    <td style="width: 30%;"><span t-field="rec.name"/></td>
                                    <td class="font-weight-bold bg-light" style="width: 20%;">Postcode</td>
                                    <td style="width: 30%;"><span t-field="rec.postcode"/></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold bg-light">Partner</td>
                                    <td><span t-field="rec.partner_id"/></td>
                                    <td class="font-weight-bold bg-light">Date Available</td>
                                    <td><span t-field="rec.date_availab"/></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold bg-light">Selling Price</td>
                                    <td colspan="3"><span t-field="rec.selling_price"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <br/>

                        <!-- Additional Information Section -->
                        <table class="table table-bordered table-sm" style="font-size: 14px;">
                            <thead>
                                <tr class="bg-light">
                                    <th colspan="4" class="text-center font-weight-bold" style="background-color: #f2f2f2; color: #2C3E50;">
                                        Additional Information
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="font-weight-bold bg-light" style="width: 20%;">Owner</td>
                                    <td style="width: 30%;"><span t-field="rec.owner_id"/></td>
                                    <td class="font-weight-bold bg-light" style="width: 20%;">Phone</td>
                                    <td style="width: 30%;"><span t-field="rec.owner_phone"/></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold bg-light">Address</td>
                                    <td><span t-field="rec.owner_address"/></td>
                                    <td class="font-weight-bold bg-light">Bedrooms</td>
                                    <td><span t-field="rec.bedrooms"/></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold bg-light">Living Area</td>
                                    <td><span t-field="rec.living_area"/></td>
                                    <td class="font-weight-bold bg-light">Facades</td>
                                    <td><span t-field="rec.facades"/></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold bg-light">Garage</td>
                                    <td><span t-field="rec.garage"/></td>
                                    <td class="font-weight-bold bg-light">Garden Area</td>
                                    <td><span t-field="rec.garden_area"/></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold bg-light">Garden Orientation</td>
                                    <td colspan="3"><span t-field="rec.garden_orientation"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>